{
  "name": "fuori-programma-cosenza",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "preview": "vite preview",
    "build": "npm run data:pull && npm run legacy:sync && npm run og:build && vite build",
    "og:build": "node scripts/make_og.mjs",
    "data:pull": "node scripts/pull_published_data.mjs",
    "data:pull:check": "node scripts/pull_published_data.mjs --dry-run",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "legacy:sync": "node scripts/sync_legacy.mjs",
    "test:svelte": "npm run legacy:sync && node scripts/test_svelte.mjs",
    "test:svelte:browser": "node scripts/test_svelte_browser.mjs",
    "test:preview": "node scripts/verify_preview.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "sharp": "0.35.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
